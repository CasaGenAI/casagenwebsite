# ── Local development only ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.
#
# In production (Cloudflare), these are set via:
#   wrangler secret put POSTMARK_SERVER_TOKEN
# Or in the Cloudflare dashboard:
#   Workers & Pages → casagenwebsite → Settings → Variables and Secrets
# ────────────────────────────────────────────────────────────────────────────

# App
VITE_APP_URL=https://app.casagen.ai

# Postmark — get your token from postmarkapp.com > Server > API Tokens
POSTMARK_SERVER_TOKEN=
POSTMARK_SENDER_EMAIL=info@casagen.ai
POSTMARK_SENDER_NAME=CasaGen
